{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pikamail",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [
    // No id is intentional: Wrangler provisions the namespace on first deploy,
    // writes its generated id back here, and reuses it on later deploys.
    { "binding": "PIKAMAIL_KV" }
  ]
}
